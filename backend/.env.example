# Set these in the backend process environment (or use uvicorn --env-file .env).
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Use an external PostgreSQL database on free Render; enter its secret URL in Render.
DATABASE_URL=
# Local SQLite fallback. Render requires a paid persistent disk for SQLite.
# VEDIC_DB=/var/data/vedic.db
